rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 & Phase 4.1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'karthikyernana@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Pillar 2: Validation Blueprints (Verbatim sync with firebase-blueprint.json)
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoURL', 'domain', 'role',
          'department', 'platform', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'domain', 'role',
          'department', 'platform', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 254 &&
        (data.email.matches('^[^@\\s]+@hbplus\\.fit$') || (isBootstrappedAdmin() && data.email == 'karthikyernana@gmail.com')) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.photoURL is string && data.photoURL.size() >= 0 && data.photoURL.size() <= 500 &&
        data.domain is string && data.domain.size() >= 3 && data.domain.size() <= 100 &&
        (data.domain == 'hbplus.fit' || (isBootstrappedAdmin() && data.domain == 'gmail.com')) &&
        data.role is string && data.role.size() >= 4 && data.role.size() <= 5 && data.role in ['user', 'admin'] &&
        data.department is string && data.department.size() >= 2 && data.department.size() <= 80 &&
        data.platform is string && data.platform.size() >= 3 && data.platform.size() <= 7 && data.platform in ['web', 'ios', 'android'] &&
        data.status is string && data.status.size() >= 6 && data.status.size() <= 9 && data.status in ['active', 'suspended'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'uid', 'email', 'domain', 'eventType', 'platform', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'domain', 'eventType', 'platform', 'createdAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 254 &&
        data.domain is string && data.domain.size() >= 2 && data.domain.size() <= 100 &&
        data.eventType is string && data.eventType.size() >= 6 && data.eventType.size() <= 16 &&
        data.eventType in ['LOGIN_ALLOWED', 'LOGIN_RESTRICTED', 'LOGOUT', 'ROLE_UPDATED'] &&
        data.platform is string && data.platform.size() >= 3 && data.platform.size() <= 7 &&
        data.platform in ['web', 'ios', 'android'] &&
        data.createdAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'grantedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.grantedAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(userId) && incoming().role == 'user' && incoming().status == 'active') ||
          isAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().domain == existing().domain &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Owner Profile Update (non-suspended users only, cannot alter role or status)
          (
            isOwner(userId) &&
            existing().status == 'active' &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'department', 'platform', 'updatedAt'])
          ) ||
          // Action 2: Admin Role / Status Management
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'department', 'platform', 'role', 'status', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && isAdmin();
    }

    // Collection: /audit_logs/{logId}
    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // Collection: /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isSignedIn() && isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(adminUid) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == adminUid &&
        incoming().grantedAt == request.time &&
        isAdmin();

      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(adminUid) && isAdmin();
    }
  }
}
